# PostgreSQL
POSTGRES_USER=antifox
POSTGRES_PASSWORD=antifox
POSTGRES_DB=antifox
# ANTIFOX_PG_DSN=postgresql://antifox:antifox@127.0.0.1:5432/antifox?sslmode=disable

# LLM（二选一或都填；也可在 API 配置 llm profiles）
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ANTIFOX_LLM_PROVIDER=
ANTIFOX_LLM_MODEL=
ANTIFOX_LLM_BASE_URL=

# 服务
ANTIFOX_HOST=0.0.0.0
ANTIFOX_PORT=8787
ANTIFOX_WORKER_CONCURRENCY=3
ANTIFOX_PLANNER_DEBOUNCE_MS=800
ANTIFOX_TRAFFIC_PROXY=127.0.0.1:8788

# 可选：JWT 密钥（不设则自动生成 data/jwt.key）
# ANTIFOX_JWT_SECRET=

# 可选：静态前端目录（默认 data/webui；make web-export 产出）
# ANTIFOX_WEB_DIST=

# ---- 本仓内置 OpenViking（长期知识库；勿指向个人全局实例）----
OPENVIKING_ENABLED=true
OPENVIKING_URL=http://127.0.0.1:1933
OPENVIKING_ROOT_API_KEY=penr-dev-root-key-change-me
OPENVIKING_API_KEY=penr-dev-root-key-change-me
OPENVIKING_AUTO_PROMOTE=true
OPENVIKING_URI_PREFIX=viking://resources/penr/knowledge
# embedding / VLM 填进 data/openviking/ov.conf（make ov-init 生成）
